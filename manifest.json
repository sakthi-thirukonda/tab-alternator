{
  "manifest_version": 3,
  "name": "Tab Alternator",
  "version": "1.0.0",
  "description": "Alternate between tabs in order of recently visited - with complete privacy protection",
  
  "permissions": [
    "tabs",
    "storage"
  ],
  
  "optional_permissions": [
    "history"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Alternator"
  },
  
  "options_page": "options.html",
  
  "commands": {
    "alternate-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Alternate to next recently visited tab"
    }
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}